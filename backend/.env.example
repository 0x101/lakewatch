# Backend environment — copy to .env (or use the repo-root .env).
# See the repo-root .env.example for the full variable list and notes.

# PostgreSQL connection string.
# Local dev (docker-compose): postgresql://lakewatch:lakewatch@localhost:5433/lakewatch
DATABASE_URL=postgresql://lakewatch:lakewatch@localhost:5433/lakewatch

# Comma-separated allowed CORS origins (your frontend URL(s)).
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 (optional — only needed if you serve timelapse assets from R2).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
