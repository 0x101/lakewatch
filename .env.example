# LakeWatch environment — copy to .env and fill in.
# NEVER commit your real .env or your GEE service-account key.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (the pipeline + backend both read this).
# Local dev (via docker-compose): postgresql://lakewatch:lakewatch@localhost:5433/lakewatch
# URL-encode special characters in the password (@ -> %40, : -> %3A).
DATABASE_URL=

# ── Google Earth Engine ─────────────────────────────────────────────────────
# Your GEE Cloud project id (e.g. your-gee-project).
GEE_PROJECT_ID=
# Path to your GEE service-account JSON key file (e.g. ./gee-key.json).
GEE_SERVICE_ACCOUNT_KEY=
# Optional bbox for the verify_gee connectivity check: min_lng,min_lat,max_lng,max_lat
# GEE_VERIFY_BBOX=

# ── Cloudflare R2 (optional — only for hosting timelapse GIFs/videos) ────────
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Frontend ────────────────────────────────────────────────────────────────
# Mapbox access token (free tier: 50K map loads/month) — https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
# URL the Next.js app proxies API/frame requests to (your FastAPI backend).
BACKEND_URL=http://localhost:8000
# Public URL of the deployed site, used for absolute social-share (OG) image
# links. Optional: falls back to Vercel's production domain, then to
# `domain` in city.config.json.
# NEXT_PUBLIC_SITE_URL=https://lakes.example.org
# The frontend reads this repo-root .env too; frontend/.env.local (if any)
# and host-level env vars take precedence.

# ── Backend ─────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (only needed if browsers call the API
# directly; the Next.js proxy makes requests same-origin).
# CORS_ORIGINS=http://localhost:3000

# ── Pipeline tuning (optional) ──────────────────────────────────────────────
# LAKEWATCH_WATERMARK=LakeWatch
# LAKEWATCH_CHECKPOINT_FILE=/path/to/.backfill_checkpoint.json
