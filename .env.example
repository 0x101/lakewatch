# LakeWatch environment — copy to .env and fill in.
# NEVER commit your real .env or your GEE service-account key.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (the pipeline + backend both read this).
# Local dev (via docker-compose): postgresql://lakewatch:lakewatch@localhost:5433/lakewatch
DATABASE_URL=

# ── Google Earth Engine ─────────────────────────────────────────────────────
# Your GEE Cloud project id (e.g. your-gee-project).
GEE_PROJECT_ID=
# Path to your GEE service-account JSON key file (e.g. ./gee-key.json).
GEE_SERVICE_ACCOUNT_KEY=

# ── Cloudflare R2 (optional — only for hosting timelapse GIFs/videos) ────────
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Frontend ────────────────────────────────────────────────────────────────
# Mapbox access token (free tier: 50K map loads/month) — https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
# URL the Next.js app proxies API/frame requests to (your FastAPI backend).
BACKEND_URL=http://localhost:8000
